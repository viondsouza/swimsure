# Copy this file to .env.local and fill in the values.

# Supabase → Project Settings → API (or "Connect")
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Gmail that sends the emails (needs 2-Step Verification turned on)
GMAIL_USER=yourname@gmail.com
# 16-letter app password from https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Where new-enquiry alerts go (leave blank to use GMAIL_USER)
NOTIFY_EMAIL=

# Optional: shows a "Chat on WhatsApp" button. Country code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=
